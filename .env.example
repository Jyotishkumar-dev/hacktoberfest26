# ==============================================================================
# GridGuard AI Environment Variables
# Copy this file to .env.local: cp .env.example .env.local
# ==============================================================================

# Supabase Connection (Required for database & auth)
# Find in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic Claude API (Server-side only for AI Planner recommendations)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Demo Judge Account (One-click "Try demo hospital" button on login page)
NEXT_PUBLIC_DEMO_EMAIL=demo@gridguard.ai
DEMO_PASSWORD=DemoHospital2026!
